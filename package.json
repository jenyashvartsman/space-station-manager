{
  "name": "space-station-manager",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nx run-many --target=serve --projects=client,server --parallel",
    "dev:client": "nx serve client",
    "dev:server": "nx serve server",
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=test",
    "lint": "nx run-many --target=lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.dev.yml logs -f",
    "db:generate": "drizzle-kit generate --config=libs/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=libs/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=libs/db/drizzle.config.ts",
    "db:seed": "nx run db:seed"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "antd": "^5.15.0",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.30.0",
    "express": "^4.18.0",
    "framer-motion": "^11.0.0",
    "pg": "^8.11.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "zod": "^3.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@nx/eslint": "^20.0.0",
    "@nx/js": "^20.0.0",
    "@nx/node": "^20.0.0",
    "@nx/vite": "^20.0.0",
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "^0.21.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^24.0.0",
    "nx": "^20.0.0",
    "prettier": "^3.2.0",
    "sass": "^1.72.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
